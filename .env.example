# ── FalkorDB ──────────────────────────────────────────────
FALKORDB_HOST=localhost
FALKORDB_PORT=6380
FALKORDB_GRAPH=graphsentinel

# ── Gemini (primary LLM via LiteLLM) ─────────────────────
# Get keys at https://aistudio.google.com/apikey
# Optional: set multiple keys for rotation
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=

GEMINI_MODEL=gemini/gemini-3.8-flash
DEFAULT_LLM=gemini

# ── Optional fallbacks ───────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
